      "css": ".ds-atlas-field{padding:22px;background:#102442}.ds-atlas-primary{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:44px;padding:10px 18px;border-radius:var(--radius,.375rem);font:600 .875rem/1.7 \"Inter Variable\",sans-serif;text-decoration:none;border-radius:.875rem;background:#d6e7ff;color:#102442}.ds-atlas-primary:hover{background:#fff}.ds-atlas-primary:focus-visible{outline:2px solid var(--ring,#285bd5);outline-offset:4px}"
