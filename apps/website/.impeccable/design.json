  "narrative": {
    "northStar": "Open Space",
    "overview": "Open Space gives developers room to understand state. A continuous near-white ground, dark rounded headings, and restrained violet actions frame real code and reactive values. Lavender, sage, and pale-yellow surfaces give related information a recognizable place without turning every region into a card.\n\nThe system combines generous editorial spacing with precise documentation. Manrope carries headings and the brand; Inter carries reading and controls; Geist Mono carries source. The informal, slightly rotated notes belong to the live-example composition, while article pages retain an orderly reading shell.",
    "keyCharacteristics": [
      "Near-white space and charcoal type establish the light identity; semantic plum tones carry dark mode.",
      "Manrope headings, Inter prose, and Geist Mono source keep their distinct roles.",
      "Lavender, sage, and pale-yellow fields organize functional content with restrained depth.",
      "Zaidan owns control states; authored motion follows real dispatch activity."
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "Resolve light and dark surfaces through the implemented semantic properties. Theme and language are independent settings; neither selects another visual identity.",
        "section": "colors"
      },
      {
        "name": "The Reading Face Rule",
        "body": "Use Manrope for headings and the brand, Inter for prose and controls, and Geist Mono for source. Preserve selectable, keyboard-scrollable code.",
        "section": "typography"
      },
      {
        "name": "The Functional Depth Rule",
        "body": "Use tonal separation for ordinary content and soft elevation for floating results or the working counter. Keep depth subordinate to reading and interaction.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** carry Open Space across the homepage and documentation using the semantic palette.",
      "**Do** use Zaidan components and exported recipes for all controls and links, preserving native anchors and typed router links.",
      "**Do** preserve visible focus, keyboard access, English/French parity, and reduced-motion behavior.",
      "**Do** keep source inspectable and connect authored activity to real state updates."
    ],
    "donts": [
      "**Don't** reuse the superseded navy-and-ivory Signal Atlas identity.",
      "**Don't** use Manrope for reading prose or code.",
      "**Don't** turn the homepage's rotated-note composition into a requirement for every article.",
      "**Don't** replace readable source or working controls with a decorative image."
    ]
  }
}
