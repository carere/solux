    {
      "name": "Counter action",
      "kind": "button",
      "refersTo": "action-primary",
      "description": "A real counter control uses the shared primary palette; the application supplies dispatch behavior.",
      "html": "<button class=\"ds-counter-action\" type=\"button\">Increment</button>",
      "css": ".ds-counter-action{display:inline-flex;align-items:center;justify-content:center;min-height:36px;padding:0 10px;border:1px solid var(--primary,#285bd5);border-radius:var(--radius,.875rem);background:var(--primary,#285bd5);color:var(--primary-foreground,#fff);font:500 .75rem/1.42857 \"Inter Variable\",sans-serif;transition:all .15s}.ds-counter-action:hover:not(:disabled){border-color:var(--foreground,#1a2b43);background:var(--foreground,#1a2b43);color:var(--background,#f5f6f8)}.ds-counter-action:focus-visible{outline:2px solid var(--ring,#285bd5);outline-offset:4px;box-shadow:0 0 0 3px color-mix(in srgb,var(--ring,#285bd5) 50%,transparent)}.ds-counter-action:active:not(:disabled){translate:0 1px}.ds-counter-action:disabled{opacity:.5;pointer-events:none}@media(max-width:767px){.ds-counter-action{min-height:44px;padding-inline:12px}}@media(prefers-reduced-motion:reduce){.ds-counter-action{transition-duration:.01ms}}"
    },
    {
      "name": "Introduction primary action",
      "kind": "button",
      "refersTo": "action-inverse",
      "description": "Pale blue action against the invariant navy field; hover becomes white and focus stays pale blue.",
      "html": "<div class=\"ds-atlas-field\"><a class=\"ds-atlas-primary\" href=\"/docs/getting-started\">Get started <svg aria-hidden=\"true\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></a></div>",
      "css": ".ds-atlas-field{padding:22px;background:#102442}.ds-atlas-primary{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:44px;padding:10px 18px;border-radius:var(--radius,.875rem);font:600 .875rem/1.7 \"Inter Variable\",sans-serif;text-decoration:none;background:#d6e7ff;color:#102442}.ds-atlas-primary:hover{background:#fff}.ds-atlas-primary:focus-visible{outline:2px solid #a9cdff;outline-offset:4px}"
    },
    {
      "name": "Introduction text action",
      "kind": "button",
      "refersTo": "action-text",
      "description": "An ivory secondary path on the navy field, underlined on hover.",
      "html": "<a class=\"ds-text-action\" href=\"/docs/api-reference\">Explore the API <svg aria-hidden=\"true\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-text-action{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:44px;padding:10px 18px;font:600 .875rem/1.7 \"Inter Variable\",sans-serif;text-decoration:none;padding:0;color:var(--hero-foreground,#f3f4e8)}.ds-text-action:hover{text-decoration:underline}.ds-text-action:focus-visible{outline:2px solid #a9cdff;outline-offset:4px;}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "search-field",
      "description": "The header’s muted search surface; full-width input with a reserved keyboard-hint area.",
      "html": "<div class=\"ds-search\"><input class=\"ds-search-input\" type=\"search\" aria-label=\"Search documentation\" placeholder=\"Search documentation\"><kbd class=\"ds-search-key\">⌘ K</kbd></div>",
      "css": ".ds-search{position:relative;width:min(360px,100%);color:var(--foreground,#1a2b43)}.ds-search-input{width:100%;height:38px;padding:4px 32px 4px 10px;border:1px solid var(--border,#d2dae8);border-radius:var(--radius,.875rem);background:var(--muted,#e9edf4);color:inherit;font:400 .875rem \"Inter Variable\",sans-serif;transition:color .15s,box-shadow .15s}.ds-search-input::placeholder{color:var(--muted-foreground,#52627a)}.ds-search-input:focus-visible{outline:2px solid var(--ring,#285bd5);outline-offset:4px;border-color:var(--ring,#285bd5);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring,#285bd5) 50%,transparent)}.ds-search-key{position:absolute;right:12px;top:9px;font-size:.7rem;color:var(--muted-foreground,#52627a);pointer-events:none}@media(max-width:767px){.ds-search-input{height:40px;font-size:1rem}}@media(prefers-reduced-motion:reduce){.ds-search-input{transition-duration:.01ms}}"
    },
