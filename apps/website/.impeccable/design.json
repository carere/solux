      "css": ".ds-select{position:relative;display:inline-block}.ds-select select{height:36px;min-width:0;width:100%;padding:4px 10px;border:1px solid var(--input,#d4cbdc);border-radius:calc(var(--radius,.875rem) - 2px);background:transparent;color:var(--foreground,#2d2c32);font:400 14px/20px \"Inter Variable\",sans-serif;outline:none;box-shadow:0 1px 2px 0 rgb(0 0 0 / .05);transition:color .15s cubic-bezier(.4,0,.2,1),box-shadow .15s cubic-bezier(.4,0,.2,1);appearance:none;padding-right:32px;cursor:pointer}.ds-select select:hover{border-color:var(--input,#d4cbdc)}.ds-select select:focus-visible{border-color:var(--ring,#7655a8);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#7655a8) 50%,transparent);}.ds-select select:disabled{pointer-events:none;opacity:.5}.ds-select svg{position:absolute;right:10px;top:50%;width:16px;height:16px;transform:translateY(-50%);color:var(--muted-foreground,#706b7a);pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-select select{transition-duration:.01ms}}:host-context(.dark) .ds-select select{background:color-mix(in oklab,var(--input,#685876) 30%,transparent)}:host-context(.dark) .ds-select select:hover{background:color-mix(in oklab,var(--input,#685876) 50%,transparent)}"
