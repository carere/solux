      "css": ".ds-search{position:relative;display:block;width:300px;max-width:100%}.ds-search input{height:36px;min-width:0;width:100%;padding:4px 10px;border:1px solid var(--input,#d4cbdc);border-radius:calc(var(--radius,.875rem) - 2px);background:transparent;color:var(--foreground,#2d2c32);font:400 14px/20px \"Inter Variable\",sans-serif;outline:none;box-shadow:0 1px 2px 0 rgb(0 0 0 / .05);transition:color .15s cubic-bezier(.4,0,.2,1),box-shadow .15s cubic-bezier(.4,0,.2,1);padding-right:32px}.ds-search input::placeholder{color:var(--muted-foreground,#706b7a)}.ds-search input:hover{border-color:var(--input,#d4cbdc)}.ds-search input:focus-visible{border-color:var(--ring,#7655a8);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#7655a8) 50%,transparent);}.ds-search input:disabled{pointer-events:none;opacity:.5}.ds-search kbd{position:absolute;right:12px;top:9px;color:var(--muted-foreground,#706b7a);font:11.2px/16px \"Geist Mono Variable\",monospace;pointer-events:none}@media(max-width:767px){.ds-search input{font-size:16px}}@media(prefers-reduced-motion:reduce){.ds-search input{transition-duration:.01ms}}:host-context(.dark) .ds-search input{background:color-mix(in oklab,var(--input,#685876) 30%,transparent)}"
