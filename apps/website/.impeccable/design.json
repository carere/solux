      "css": ".ds-nav{display:grid;gap:4px;font:400 .8125rem \"Inter Variable\",sans-serif}.ds-nav-item{display:flex;align-items:center;min-height:34px;padding:8px;border-radius:var(--radius,.875rem);color:var(--sidebar-foreground,#1a2b43);text-decoration:none}.ds-nav-item:hover{background:var(--sidebar-accent,#e0e9fc);color:var(--sidebar-accent-foreground,#214ca1)}.ds-nav-item[aria-current=page]{background:var(--accent,#e0e9fc);color:var(--primary,#285bd5);font-weight:650}.ds-nav-item:focus-visible{outline:2px solid var(--ring,#285bd5);outline-offset:4px;}@media(max-width:767px){.ds-nav-item{min-height:40px}}"
    },
    {
      "name": "Documentation note",
      "kind": "card",
      "refersTo": "note",
      "description": "A flat, muted callout with an accent label and compact explanatory prose.",
      "html": "<aside class=\"ds-note\"><strong class=\"ds-note-label\">Store ownership</strong><p class=\"ds-note-copy\">The store creator owns disposal.</p></aside>",
      "css": ".ds-note{padding:20px 22px;border-radius:var(--radius,.875rem);background:var(--muted,#e9edf4);color:var(--foreground,#1a2b43);font-family:\"Inter Variable\",sans-serif}.ds-note-label{font-size:.75rem;color:var(--primary,#285bd5)}.ds-note-copy{margin:5px 0 0;font-size:.8125rem;line-height:1.8}"
    },
    {
      "name": "Source region",
      "kind": "custom",
      "refersTo": "source-panel",
      "description": "The instrument’s navy source half has selectable, horizontally scrollable code. Documentation code panels use the deeper shared code background.",
      "html": "<section class=\"ds-source\"><div class=\"ds-source-heading\"><h3 class=\"ds-source-title\">Source</h3><span>counter.ts</span></div><pre class=\"ds-source-code\" tabindex=\"0\"><code>builder.addHandler(\n  increment, (state, { payload }) =&gt; {\n    state.value += payload;\n  },\n);</code></pre></section>",
      "css": ".ds-source{display:flex;flex-direction:column;justify-content:center;padding:26px;background:#1b365c;color:var(--code-foreground,#eef5ff)}.ds-source-heading{display:flex;justify-content:space-between;gap:12px;margin-bottom:15px;font:400 .6875rem \"Inter Variable\",sans-serif;color:#b8cdeb}.ds-source-title{margin:0;font-size:.75rem;font-weight:550}.ds-source-code{margin:0;max-width:100%;overflow-x:auto;font:.8125rem/1.9 var(--font-mono,\"Geist Mono Variable\",monospace);tab-size:2;scrollbar-color:#54739a var(--code,#0d2442)}.ds-source-code:focus-visible{outline:2px solid #a9cdff;outline-offset:4px}@media(max-width:767px){.ds-source{padding:20px 18px;border-top:1px solid var(--hero-border,#3d5476)}.ds-source-code{font-size:.75rem}}"
    },
    {
      "name": "Live state readout",
      "kind": "custom",
      "description": "A static styling sample of the real counter’s paired state and derived value; the application supplies the store and event behavior.",
      "html": "<div class=\"ds-readout\"><div class=\"ds-reading\"><span class=\"ds-reading-label\">state.counter.value</span><output class=\"ds-reading-value\" aria-label=\"Counter value\">1</output></div><div class=\"ds-reading\"><span class=\"ds-reading-label\">createMemo(() =&gt; value * 2)</span><output class=\"ds-reading-value\" aria-label=\"Doubled value\">2</output></div></div>",
      "css": ".ds-readout{display:grid;grid-template-columns:1fr 1fr;gap:16px;padding:18px;background:var(--surface,#fff);color:var(--foreground,#1a2b43)}.ds-reading+.ds-reading{padding-left:25px;border-left:1px solid var(--border,#d2dae8)}.ds-reading-label{display:block;font:.6875rem/1.6 var(--font-mono,\"Geist Mono Variable\",monospace);color:var(--muted-foreground,#52627a);overflow-wrap:anywhere}.ds-reading-value{display:block;margin-top:5px;font:600 3rem/1.2 var(--font-heading,\"Manrope\",sans-serif);letter-spacing:-.035em;font-variant-numeric:tabular-nums}@media(max-width:767px){.ds-reading+.ds-reading{padding-left:16px}}"
    },
    {
      "name": "Event-flow step",
      "kind": "custom",
      "description": "A static sample of the active event stage. The application updates labels and renews a 480ms pulse per real dispatch; reduced motion skips the pulse.",
      "html": "<div class=\"ds-flow\"><div class=\"ds-flow-step\" data-active=\"true\"><span class=\"ds-flow-label\">Event</span><code class=\"ds-flow-code\">counter/increment</code></div></div>",
      "css": ".ds-flow{border-block:1px solid var(--hero-border,#3d5476);color:var(--hero-foreground,#f3f4e8);background:var(--hero-background,#102442)}.ds-flow-step{display:flex;flex-direction:column;align-items:center;gap:5px;min-width:0;padding:16px 12px;text-align:center;font:.8125rem/1.6 \"Inter Variable\",sans-serif}.ds-flow-step[data-active=true]{color:#d5e5ff;background:color-mix(in srgb,var(--hero-foreground,#f3f4e8) 7%,transparent)}.ds-flow-label,.ds-flow-code{color:var(--hero-muted,#bacce9);font-size:.6875rem;overflow-wrap:anywhere}.ds-flow-code{font-family:var(--font-mono,\"Geist Mono Variable\",monospace)}@media(max-width:767px){.ds-flow{padding-block:6px}.ds-flow-step{display:grid;grid-template-columns:86px minmax(0,1fr);gap:10px;align-items:baseline;padding:9px 12px;text-align:left}.ds-flow-label,.ds-flow-code{font-size:.75rem;overflow-wrap:normal}.ds-flow-code{white-space:normal}}"
    }
  ],
  "narrative": {
    "northStar": "Signal Atlas",
    "overview": "Signal Atlas is the selected Solux website identity. It pairs deep navy fields and ivory Manrope headings with a light, precise reading environment. Blue actions, fine rules, and rounded instruments make the relationships between source and state visible.\n\nThe system serves developer reading and inspection. Inter carries prose and interface text; Geist Mono distinguishes source, commands, and state paths. Color fields and aligned regions provide structure, while real dispatch activity supplies the authored motion.",
    "keyCharacteristics": [
      "Navy and ivory identify the instrument field in both light and dark modes.",
      "Manrope headings, Inter reading text, and Geist Mono source have distinct roles.",
      "Functional panels use rounded boundaries, tonal separation, and fine rules.",
      "State feedback reflects real events and respects reduced motion."
    ],
    "rules": [
      {
        "name": "The Independent Settings Rule",
        "body": "Every route uses the static Atlas identity. Light/dark mode and English/French language remain independent settings; colors resolve through the semantic custom properties.",
        "section": "colors"
      },
      {
        "name": "The Reading Face Rule",
        "body": "Use Manrope for headings and the brand, Inter for reading and controls, and Geist Mono for source. Keep code selectable and horizontally scrollable when its content needs it.",
        "section": "typography"
      },
      {
        "name": "The Structural Depth Rule",
        "body": "Distinguish source, state, reading, and floating regions with their implemented surface, border, and field roles. Use floating elevation for popovers and overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** carry Signal Atlas across the homepage and documentation.",
      "**Do** resolve reading-surface colors and corners through the semantic tokens.",
      "**Do** preserve visible focus, reduced-motion behavior, and English/French parity.",
      "**Do** connect visual activity to real events and keep source inspectable."
    ],
    "donts": [
      "**Don't** change the identity when changing language or light/dark mode.",
      "**Don't** replace the existing Solux logo or SVG favicon.",
      "**Don't** use the display face for reading prose or code.",
      "**Don't** promote a first-surface composition into a requirement for every documentation page."
    ]
  }
}
