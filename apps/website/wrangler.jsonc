{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solux-website",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "solux.carere.dev", "custom_domain": true }]
}
